{
  "name": "ephem-service",
  "version": "0.1.0",
  "description": "Small HTTP service that returns planet positions and house cusps computed with Swiss Ephemeris",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsc -p tsconfig.json && node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "11.3.1",
    "@fastify/rate-limit": "11.2.1",
    "fastify": "5.12.7",
    "sweph": "2.10.3-8"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
